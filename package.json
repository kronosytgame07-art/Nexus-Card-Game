{
  "name": "nexus-card-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:capacitor": "tsc -b && cross-env CAPACITOR_BUILD=1 vite build && npx cap sync",
    "build:itch": "tsc -b && cross-env ITCH_BUILD=1 vite build",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.17.1",
    "framer-motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cross-env": "^10.1.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
