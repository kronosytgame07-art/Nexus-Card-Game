# Configuration Firebase pour l'écran Échanges (comptes joueurs + offres d'échange).
# Facultatif : sans ces variables, le jeu reste jouable normalement en solo — seul l'écran
# Échanges affiche un message d'indisponibilité. Voir la section "Configurer Firebase pour les
# échanges" du README.md pour la marche à suivre complète.
#
# Copie ce fichier en `.env.local` (déjà ignoré par git) et remplis les valeurs depuis la
# console Firebase de ton projet (Paramètres du projet > Général > Vos applications > SDK).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
